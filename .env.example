# Clave API de Google Gemini (Imprescindible para propuestas IA, renders y buscador de productos)
# Obtenla gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Base de datos Postgres (Opcional, si no se proporciona funciona en modo almacenamiento local de navegador)
# Puedes crear una gratis en Neon (https://neon.tech) o activar Vercel Postgres / Neon Storage en Vercel
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.eu-central-1.aws.neon.tech/neondb?sslmode=require
